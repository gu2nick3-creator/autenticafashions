VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mercado Pago (server-side only — never prefix with VITE_, keep out of the client bundle)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Random string, must match public.app_secrets (key='mp_webhook_secret') in Supabase
MP_WEBHOOK_SECRET=

# Melhor Envio (server-side only) — calculates real Correios/carrier shipping rates by CEP
# Get a token at melhorenvio.com.br > Integrações > Gerar Token (no business contract needed)
MELHOR_ENVIO_TOKEN=
# CEP the packages ship from (store/warehouse), digits only or formatted
MELHOR_ENVIO_FROM_CEP=
# 'true' to use the sandbox environment (fake prices, for testing)
MELHOR_ENVIO_SANDBOX=
